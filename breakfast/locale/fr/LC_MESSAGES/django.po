msgid "Breakfast on %(date)s"
msgstr "Petit-déjeuner du %(date)s"

#: breakfast/notifications.py
msgid ""
"Hello,\n"
"\n"
"You have been chosen to host the breakfast taking place on:\n"
"\t%(date)s\n"
"\n"
"The number of participants expected per host is %(per_host)d.\n"
"If you can prepare home-made food, you will earn bonus points!\n"
"\n"
"Kind regards,\n"
"Chief Breakfast Officer"
msgstr ""
"Bonjour,\n"
"\n"
"Vous avez été désigné(e) comme organisateur du petit-déjeuner qui aura lieu le :\n"
"\t%(date)s\n"
"\n"
"Le nombre de participants attendus par organisateur est de %(per_host)d.\n"
"Si vous pouvez préparer des plats faits maison, vous obtiendrez des points bonus !\n"
"\n"
"Bien cordialement,\n"
"Chief Breakfast Officer"

#: breakfast/notifications.py
msgid ""
"Hello,\n"
"\n"
"You are invited to the breakfast taking place on:\n"
"\t%(date)s\n"
"\n"
"For your information, the hosts are:%(hosts)s\n"
"\n"
"The leaderboard now reads:\n"
"Few points:%(lowest)s\n"
"Many points:%(highest)s\n"
"\n"
"CBO"
msgstr ""
"Bonjour,\n"
"\n"
"Vous êtes convié(e) au petit-déjeuner qui aura lieu le :\n"
"\t%(date)s\n"
"\n"
"Pour information, les organisateurs désignés sont :%(hosts)s\n"
"\n"
"Le tableau des scores devient :\n"
"Peu de points :%(lowest)s\n"
"Beaucoup de points :%(highest)s\n"
"\n"
"CBO"

#: breakfast/notifications.py
msgid "Two days left to prepare some home-made food"
msgstr "Plus que deux jours pour préparer des petits plats"

